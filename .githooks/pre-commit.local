#!/usr/bin/env bash
# Core-specific additions to the shared pre-commit vendored from JakobMelchard/.githooks.
# Secrets, prettier and eslint are already handled by the shared hook.
#
# Types and tests run here rather than only in CI: core is a dependency, so a
# broken export reaches every consumer before their own CI can catch it.
set -eo pipefail

npx --no-install tsc
npm test --silent
