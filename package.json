{
  "name": "@jakobmelchard/hx",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    "./handle": {
      "types": "./types/handle.d.ts",
      "default": "./src/handle.js"
    },
    "./html": {
      "types": "./types/html.d.ts",
      "default": "./src/html.js"
    },
    "./tags": {
      "types": "./types/tags.d.ts",
      "default": "./src/tags.js"
    },
    "./transport": {
      "types": "./types/transport.d.ts",
      "default": "./src/transport.js"
    },
    "./store/memory": {
      "types": "./types/store/memory.d.ts",
      "default": "./src/store/memory.js"
    },
    "./store/fs": {
      "types": "./types/store/fs.d.ts",
      "default": "./src/store/fs.js"
    },
    "./store/r2": {
      "types": "./types/store/r2.d.ts",
      "default": "./src/store/r2.js"
    },
    "./store/contract": {
      "types": "./types/store/contract.d.ts",
      "default": "./src/store/contract.js"
    },
    "./store/saf": {
      "types": "./types/store/saf.d.ts",
      "default": "./src/store/saf.js"
    },
    "./types": {
      "types": "./types/types.d.ts",
      "default": "./src/types.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node --test \"test/e2e/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "htmx.org": "4.0.0",
    "playwright-core": "^1",
    "typescript": "^5"
  }
}
